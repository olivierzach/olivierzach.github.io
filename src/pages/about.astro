---
import Base from '../layouts/Base.astro';

const workItems = [
  { role: 'Senior Machine Learning Engineer', org: 'SpaceX', dates: '2024 - Present', logo: '/logos/spacex.svg', href: 'https://www.spacex.com/', tone: 'spacex', detail: 'Production ML systems with high reliability requirements.' },
  { role: 'Lead Data Scientist', org: 'DataStax', dates: '2022 - 2024', logo: '/logos/datastax.svg', href: 'https://www.datastax.com/', tone: 'datastax', detail: 'Search, retrieval, telemetry, and applied ML for developer-facing products.' },
  { role: 'Senior Machine Learning Engineer', org: 'Sony Pictures Entertainment', dates: '2019 - 2022', logo: '/logos/sony.svg', href: 'https://www.sonypictures.com/', tone: 'sony', detail: 'Forecasting, experimentation, and media data products.' },
  { role: 'Data Scientist, Product', org: 'Keap', dates: '2018 - 2019', logo: '/logos/keap.svg', href: 'https://keap.com/', tone: 'keap', detail: 'Product analytics, growth measurement, and customer lifecycle modeling.' },
  { role: 'Data Scientist / Analyst', org: 'Mazda North American Operations', dates: '2013 - 2018', logo: '/logos/mazda.svg', href: 'https://www.mazdausa.com/', tone: 'mazda', detail: 'Business analytics, modeling, and operational reporting.' },
];

const educationItems = [
  {
    degree: 'M.S., Computer Science',
    org: 'Georgia Institute of Technology',
    dates: '2018 - 2020',
    logo: '/logos/georgia-tech.svg',
    href: 'https://www.gatech.edu/',
    tone: 'gatech',
    detail: 'Machine learning, deep learning, reinforcement learning, probabilistic models, distributed systems.',
  },
  {
    degree: 'B.S., Statistics',
    org: 'San Diego State University',
    dates: '2009 - 2013',
    logo: '/logos/sdsu.svg',
    href: 'https://www.sdsu.edu/',
    tone: 'sdsu',
    detail: 'Probability, mathematical statistics, linear algebra, regression, experimental design.',
  },
];
---

<Base title="About" description="About Zach Olivier, a machine learning engineer focused on production ML, applied research tooling, evaluation, and reliability.">
  <div class="about-page">
    <section class="about-hero">
      <div>
        <p class="section-eyebrow">About Zach Olivier</p>
        <h1>ML systems, evaluation, and applied research tooling.</h1>
        <p>
          I build the parts of machine learning work that have to survive contact with real data: pipelines, experiments, observability, evaluation, and production feedback.
        </p>
      </div>
      <div class="about-links" aria-label="Profile links">
        <a href="https://github.com/olivierzach">GitHub</a>
        <a href="https://www.linkedin.com/in/olivierzach/">LinkedIn</a>
        <a href="https://x.com/Zach0__">X</a>
      </div>
    </section>

    <section class="timeline-section" aria-labelledby="work-title">
      <div class="section-heading">
        <h2 id="work-title">Work</h2>
      </div>
      <ol class="timeline-list">
        {workItems.map((item) => (
          <li>
            <a class={`timeline-logo ${item.tone}`} href={item.href} aria-label={item.org}>
              <img src={item.logo} alt="" loading="lazy" />
            </a>
            <div class="timeline-body">
              <div class="timeline-topline">
                <strong>{item.role}</strong>
                <span>{item.dates}</span>
              </div>
              <a class="timeline-org" href={item.href}>{item.org}</a>
              <p>{item.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="timeline-section" aria-labelledby="education-title">
      <div class="section-heading">
        <h2 id="education-title">Education</h2>
      </div>
      <ol class="timeline-list">
        {educationItems.map((item) => (
          <li>
            <a class={`timeline-logo ${item.tone}`} href={item.href} aria-label={item.org}>
              <img src={item.logo} alt="" loading="lazy" />
            </a>
            <div class="timeline-body">
              <div class="timeline-topline">
                <strong>{item.degree}</strong>
                <span>{item.dates}</span>
              </div>
              <a class="timeline-org" href={item.href}>{item.org}</a>
              <p>{item.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="about-footer-grid" aria-label="More information">
      <div>
        <h2>Open To</h2>
        <p>Research engineering and ML engineering teams at labs, scientific organizations, and product groups where rigorous systems work matters.</p>
      </div>
    </section>
  </div>
</Base>
