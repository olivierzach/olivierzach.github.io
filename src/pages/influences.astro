---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('books')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const papers = (await getCollection('papers')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

const topPapers = papers.slice(0, 18);
---

<Base title="Influences" description="Books and papers that shaped how I think.">
  <div class="prose">
    <h1>Influences</h1>
    <p class="kicker">A short list of books and papers that shaped how I think about ML, systems, and research.</p>

    <h2>Books</h2>
    <div class="shelf" role="list">
      {books.map((b) => (
        <a class="tile" role="listitem" href={`/influences/books/${b.id}`} aria-label={b.data.title}>
          <div class="poster">
            {b.data.cover ? (
              <img
                src={b.data.cover}
                srcset={b.data.cover.endsWith('.jpg') ? `${b.data.cover.replace('/covers/','/covers/_optimized/').replace('.jpg','-w240.webp')} 240w, ${b.data.cover.replace('/covers/','/covers/_optimized/').replace('.jpg','-w360.webp')} 360w` : undefined}
                sizes="160px"
                alt={`Cover: ${b.data.title}`}
                loading="lazy"
              />
            ) : (
              <div class="cover-fallback">No cover</div>
            )}
          </div>
          <div class="tile-meta">
            <div class="tile-title">{b.data.title}</div>
            <div class="meta">{b.data.authors ? b.data.authors : ''}{b.data.year ? ` · ${b.data.year}` : ''}</div>
          </div>
        </a>
      ))}
    </div>

    <h2>Papers (high signal)</h2>
    <p class="meta">This is intentionally curated; the full reading list lives under <a href="/papers">Papers</a>.</p>
    <ul>
      {topPapers.map((p) => (
        <li>
          <a href={`/papers/${p.id}`}>{p.data.title}</a>
          <span class="meta"> — {p.data.authors ? `${p.data.authors}, ` : ''}{p.data.year ?? ''}</span>
        </li>
      ))}
    </ul>
  </div>
</Base>
