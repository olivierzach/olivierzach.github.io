---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(p => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <div class="prose project-detail">
    <h1>{entry.data.title}</h1>
    <p class="kicker">{entry.data.summary}</p>
    <p class="meta">
      Status: {entry.data.status}
      {entry.data.github ? <> · <a href={entry.data.github}>GitHub</a></> : null}
      {entry.data.demo ? <> · <a href={entry.data.demo}>Demo</a></> : null}
    </p>
    {entry.data.thumbnail ? <img class="project-hero-image" src={entry.data.thumbnail} alt="" /> : null}
    <hr />
    <Content />
  </div>
</Base>
