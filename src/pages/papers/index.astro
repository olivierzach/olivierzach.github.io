---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const papers = (await getCollection('papers'))
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

const recentPapers = [...papers].sort((a, b) =>
  (b.data.date?.valueOf() ?? Date.UTC(b.data.year ?? 1970, 0, 1)) -
  (a.data.date?.valueOf() ?? Date.UTC(a.data.year ?? 1970, 0, 1)) ||
  a.data.title.localeCompare(b.data.title)
);

function hasTag(entry, names) {
  const tags = entry.data.tags.map((tag) => tag.toLowerCase());
  return names.some((name) => tags.some((tag) => tag.includes(name)));
}

function thumbSources(src) {
  if (!src?.startsWith('/papers/') || !src.endsWith('-w360.webp')) return null;
  return {
    srcset: `${src.replace('-w360.webp', '-w240.webp')} 240w, ${src} 360w`,
    src,
  };
}

function visibleTags(entry) {
  if (hasTag(entry, ['zotero-import'])) return [];
  return entry.data.tags
    .filter((tag) => !['zotero-paper', 'zotero-reading', 'to-read', 'journal-article', 'conference-paper', 'preprint'].includes(tag.toLowerCase()))
    .slice(0, 2);
}

const rows = [
  {
    id: 'recent',
    title: 'Recent',
    summary: 'Recently saved references, with publication years shown on each card.',
    items: recentPapers.slice(0, 12),
  },
  {
    id: 'zotero-library',
    title: 'Reading Library',
    summary: 'Saved references and reading plans. Items marked “To read” are in the queue.',
    items: recentPapers.filter((paper) => hasTag(paper, ['zotero-import', 'zotero-reading'])),
  },
  {
    id: 'carmack-list',
    title: 'Sutskever / Carmack',
    items: papers.filter((paper) => hasTag(paper, ['carmack-list'])),
  },
  {
    id: 'core-ai',
    title: 'Core AI',
    items: papers.filter((paper) => hasTag(paper, ['transformers', 'residual', 'architecture', 'foundation-models', 'representation', 'scaling', 'sequence'])),
  },
  {
    id: 'uncertainty-evidence',
    title: 'Uncertainty & Evidence',
    items: papers.filter((paper) => hasTag(paper, ['uncertainty', 'e-values', 'bayesian', 'conformal'])),
  },
  {
    id: 'agency-rl',
    title: 'Agency & RL',
    items: papers.filter((paper) => hasTag(paper, ['reinforcement', 'control', 'active-inference', 'agents'])),
  },
  {
    id: 'ai-consciousness',
    title: 'AI Consciousness',
    items: papers.filter((paper) => hasTag(paper, ['consciousness'])),
  },
  {
    id: 'optimization-training',
    title: 'Learning',
    items: papers.filter((paper) => hasTag(paper, ['optimization', 'training'])),
  },
  {
    id: 'applied-modeling',
    title: 'Applied Modeling',
    items: papers.filter((paper) => hasTag(paper, ['tabular', 'survival', 'wtte', 'time-to-event', 'reliability', 'competing-risks', 'medical-modeling'])),
  },
  {
    id: 'vision-anomaly',
    title: 'Vision & Anomaly',
    items: papers.filter((paper) => hasTag(paper, ['vision', 'anomaly', 'industrial-vision', 'segmentation', 'cascaded-roi'])),
  },
  {
    id: 'suggested-next',
    title: 'Suggested Next',
    items: papers.filter((paper) => hasTag(paper, ['suggested-next'])),
  },
  {
    id: 'systems-eval',
    title: 'Practice',
    items: papers.filter((paper) => hasTag(paper, ['systems', 'evaluation', 'data', 'ml-practice'])),
  },
  {
    id: 'audio-retrieval',
    title: 'Audio & Retrieval',
    items: papers.filter((paper) => hasTag(paper, ['audio', 'retrieval'])),
  },
  {
    id: 'theory-alife',
    title: 'Theory & Artificial Life',
    items: papers.filter((paper) => hasTag(paper, ['artificial-life', 'alife', 'complexity', 'theory'])),
  },
  {
    id: 'all-papers',
    title: 'All',
    items: papers,
  },
];
---

<Base title="Papers" description="Zach Olivier's research library across ML systems, evaluation, reliability, artificial life, uncertainty, and applied modeling.">
  <div class="browse-page paper-page">
    <section class="browse-hero browse-hero-papers" aria-labelledby="papers-title">
      <div class="browse-hero-copy">
        <h1 id="papers-title">Papers</h1>
        <p>References and working notes around ML systems, evaluation, reliability, artificial life, uncertainty, and applied modeling.</p>
      </div>
    </section>

    <div class="browse-stack" aria-label="Paper shelves">
      {rows.map((row) => row.items.length ? (
        <section class="browse-row" aria-labelledby={`${row.id}-title`}>
          <div class="browse-row-header">
            <h2 id={`${row.id}-title`}>{row.title}</h2>
            {row.summary ? <p>{row.summary}</p> : null}
          </div>
          <div class="poster-row" role="list">
            {row.items.map((p) => {
              const thumbs = thumbSources(p.data.thumbnail);
              const paperHref = p.data.pdf_url ?? p.data.link;
              return (
                <a class="browse-tile paper-tile" role="listitem" href={paperHref} aria-label={p.data.title} target="_blank" rel="noopener noreferrer">
                  <div class="browse-poster paper-poster">
                    {p.data.thumbnail ? (
                      <img
                        src={thumbs?.src ?? p.data.thumbnail}
                        srcset={thumbs?.srcset}
                        sizes="(min-width: 900px) 180px, 150px"
                        alt={`Thumbnail: ${p.data.title}`}
                        loading="lazy"
                      />
                    ) : (
                      <div class="paper-fallback">
                        <div class="paper-fallback-title">{p.data.title}</div>
                        <div class="meta">{p.data.year ?? ''}</div>
                      </div>
                    )}
                  </div>
                  <div class="tile-meta">
                    <div class="tile-title">{p.data.title}</div>
                    <div class="meta">{p.data.authors ? p.data.authors : ''}{p.data.year ? ` · ${p.data.year}` : ''}</div>
                  </div>
                  <div class="tile-actions">
                    <span>{p.data.pdf_url ? 'PDF' : 'Paper'}</span>
                    {hasTag(p, ['to-read']) ? <span>To read</span> : null}
                    {!hasTag(p, ['to-read']) ? visibleTags(p).map((tag) => <span>{tag}</span>) : null}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ) : null)}
    </div>
  </div>
</Base>
