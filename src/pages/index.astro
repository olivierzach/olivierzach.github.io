---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import homepage from '../data/homepage.json';

const projects = await getCollection('projects');
const projectById = new Map(projects.map((project) => [project.id, project]));
const featuredProjects = homepage.featuredProjects
  .map((item) => projectById.get(item.slug))
  .filter(Boolean);
---

<Base title="Zachary S. Olivier" description={homepage.headline}>
  <div class="home-page">
    <section class="home-hero">
      <div class="home-hero-copy">
        <p class="section-eyebrow">Zachary S. Olivier</p>
        <h1>{homepage.headline}</h1>
        <p class="home-summary">{homepage.summary}</p>

        <div class="home-actions" aria-label="Primary links">
          <a href="/projects">Projects</a>
          <a href="https://github.com/olivierzach" rel="me">GitHub</a>
          <a href="https://www.linkedin.com/in/olivierzach/" rel="me">LinkedIn</a>
          <a href="/contact">Email</a>
        </div>
      </div>
    </section>

    <section class="home-featured" aria-labelledby="featured-projects-title">
      <div class="home-section-head">
        <h2 id="featured-projects-title">Selected projects</h2>
        <a href="/projects">All projects</a>
      </div>
      <ul class="featured-project-list">
        {featuredProjects.map((entry) => (
          <li>
            <a class="featured-project-main" href={`/projects/${entry.id}`}>{entry.data.title}</a>
            <span class="featured-project-actions">
              {entry.data.demo ? <a href={entry.data.demo}>Demo</a> : null}
              {entry.data.github ? <a href={entry.data.github}>GitHub</a> : null}
            </span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
