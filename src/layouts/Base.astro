---
const { title = 'Zachary S. Olivier', description = 'Applied ML engineer working on ML systems, evaluation, telemetry, and research tooling.', noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site">
      <nav>
        <a class="brand" href="/">Zachary S. Olivier</a>
        <a href="/projects">Projects</a>
        <a href="/writing">Writing</a>
        <a href="/influences">Influences</a>
        <a href="/papers">Papers</a>
        <a href="/now">Now</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="inner">
        <span>© {new Date().getFullYear()} Zachary S. Olivier.</span>
      </div>
    </footer>
  </body>
</html>
