{
  "name": "nebulous-neutron",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "covers:books": "node scripts/fetch_book_covers.mjs --all",
    "covers:opt": "node scripts/optimize_covers.mjs",
    "fetch:papers": "node scripts/fetch_papers.mjs --all",
    "thumbs:papers": "node scripts/thumb_papers_poppler.mjs --all",
    "figures:papers": "node scripts/extract_paper_figures.mjs --all",
    "art:gen": "node scripts/generate_art.mjs",
    "art:projects": "node scripts/generate_project_thumbnails.mjs",
    "art:repo-thumbs": "node scripts/generate_repo_audit_thumbnails.mjs",
    "ingest:images": "npm run covers:books && npm run covers:opt",
    "ingest:papers": "npm run fetch:papers && npm run thumbs:papers",
    "ingest:all": "npm run ingest:images && npm run ingest:papers"
  },
  "dependencies": {
    "astro": "^6.3.3",
    "gray-matter": "^4.0.3",
    "sharp": "^0.34.5"
  }
}
